{
  "name": "openai",
  "version": "1.0.0",
  "description": "OpenAI - GPT-5, GPT-4o, and O1 models",
  "author": "keepuahead",
  "keywords": ["openai", "gpt-5", "gpt-4", "o1"],
  "homepage": "https://platform.openai.com",
  "Providers": [
    {
      "name": "openai",
      "api_base_url": "https://api.openai.com/v1/chat/completions",
      "api_key": "{{apiKey}}",
      "models": ["gpt-5", "gpt-4o", "gpt-4o-mini", "o1-pro", "o1-mini"]
    }
  ],
  "Router": {
    "default": "openai,gpt-5",
    "think": "openai,o1-pro",
    "background": "openai,gpt-4o-mini"
  },
  "schema": [
    {
      "id": "apiKey",
      "type": "password",
      "label": "OpenAI API Key",
      "prompt": "Enter your OpenAI API key",
      "required": true
    }
  ]
}